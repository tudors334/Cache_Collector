// =============================================================================
// cache_tb.v  ?  Cache Controller Testbench  (random data + wave-friendly)
//
// Rulare:  vlog memory_array.v lru_controller.v cache_controller.v cache_tb.v
//          vsim -sv_seed random cache_tb
//          add wave -r /*
//          run -all
//
// Semnale utile in wave:
//   tb_op_type   : 0=READ / 1=WRITE
//   tb_result    : 0=MISS  / 1=HIT
//   tb_evict     : puls cand are loc o evacuare
//   tb_addr      : adresa curenta CPU
//   tb_wr_data   : data scrisa (write ops)
//   tb_rd_data   : data citita (read ops)
//   tb_hit_rate  : rata de hit acumulata (0?100)
//   tb_state_str : eticheta stare FSM (pentru display)
// =============================================================================

`timescale 1ns/1ps

module cache_tb;

    // =========================================================================
    // Ceas si reset
    // =========================================================================
    reg clk, rst;
    initial clk = 1'b0;
    always #5 clk = ~clk;          // 100 MHz

    // =========================================================================
    // Interfata DUT
    // =========================================================================
    reg         cpu_req;
    reg         cpu_rw;
    reg  [31:0] cpu_addr;
    reg  [31:0] cpu_wr_data;
    wire [31:0] cpu_rd_data;
    wire        cpu_ready;

    reg  [511:0] mem_rd_data;
    reg          mem_ready;
    wire         mem_req;
    wire         mem_rw;
    wire [31:0]  mem_addr;
    wire [511:0] mem_wr_data;

    // =========================================================================
    // Semnale vizibile in wave (prefix tb_)
    // =========================================================================
    reg        tb_op_type;      // 0=READ, 1=WRITE
    reg        tb_result;       // 0=MISS,  1=HIT  (valid cand tb_valid=1)
    reg        tb_valid;        // puls 1 ciclu = tranzactie noua
    reg        tb_evict;        // puls 1 ciclu = evacuare in curs
    reg [31:0] tb_addr;         // adresa tranzactiei curente
    reg [31:0] tb_wr_data;      // data scrisa
    reg [31:0] tb_rd_data;      // data citita
    reg [6:0]  tb_hit_rate;     // hit-rate acumulata (0-100)
    reg [2:0]  tb_fsm_state;    // oglinda starii FSM din DUT

    // Etichete text pentru starea FSM (afisate in Transcript, vizibile si in wave ca integer)
    // 0=IDLE 1=READ_HIT 2=READ_MISS 3=WRITE_HIT 4=WRITE_MISS 5=EVICT
    always @(*) tb_fsm_state = dut.state;

    // =========================================================================
    // Instantiere DUT
    // =========================================================================
    cache_controller dut (
        .clk         (clk),
        .rst         (rst),
        .cpu_req     (cpu_req),
        .cpu_rw      (cpu_rw),
        .cpu_addr    (cpu_addr),
        .cpu_wr_data (cpu_wr_data),
        .cpu_rd_data (cpu_rd_data),
        .cpu_ready   (cpu_ready),
        .mem_req     (mem_req),
        .mem_rw      (mem_rw),
        .mem_addr    (mem_addr),
        .mem_wr_data (mem_wr_data),
        .mem_rd_data (mem_rd_data),
        .mem_ready   (mem_ready)
    );

    // =========================================================================
    // Statistici
    // =========================================================================
    integer total_ops, hits, misses, evictions, passes, fails;

    // =========================================================================
    // Model simplu de memorie principala
    // Returneaza un bloc de 64 bytes cu date = {adresa_cuvant ^ seed}
    // =========================================================================
    integer seed;

    task automatic mem_respond;
        input [31:0] base;
        input        is_wr;
        integer k;
        begin
            repeat(2) @(posedge clk);   // latenta memorie = 2 cicluri
            if (!is_wr) begin
                for (k = 0; k < 16; k = k + 1)
                    mem_rd_data[k*32 +: 32] = {base[31:6], k[3:0], 2'b00}
                                              ^ $random(seed);
            end
            tb_evict   = is_wr ? 1'b1 : 1'b0;
            mem_ready  = 1'b1;
            @(posedge clk);
            mem_ready  = 1'b0;
            mem_rd_data= 512'b0;
            tb_evict   = 1'b0;
            if (is_wr) evictions = evictions + 1;
        end
    endtask

    // =========================================================================
    // Background: raspunde la cereri de memorie
    // =========================================================================
    initial begin
        mem_ready    = 1'b0;
        mem_rd_data  = 512'b0;
        forever begin
            @(posedge clk);
            if (mem_req)
                mem_respond(mem_addr, mem_rw);
        end
    end

    // =========================================================================
    // Task: READ
    // =========================================================================
    task do_read;
        input  [31:0] addr;
        output [31:0] data;
        begin
            @(negedge clk);
            cpu_req  = 1'b1;
            cpu_rw   = 1'b0;
            cpu_addr = addr;
            tb_addr  = addr;
            tb_op_type = 1'b0;
            tb_valid   = 1'b0;
            total_ops  = total_ops + 1;

            @(posedge clk);
            while (!cpu_ready) @(posedge clk);

            data       = cpu_rd_data;
            tb_rd_data = cpu_rd_data;

            @(negedge clk);
            cpu_req  = 1'b0;
            tb_valid = 1'b1;
            @(posedge clk);
            tb_valid = 1'b0;
        end
    endtask

    // =========================================================================
    // Task: WRITE
    // =========================================================================
    task do_write;
        input [31:0] addr;
        input [31:0] wdata;
        begin
            @(negedge clk);
            cpu_req     = 1'b1;
            cpu_rw      = 1'b1;
            cpu_addr    = addr;
            cpu_wr_data = wdata;
            tb_addr     = addr;
            tb_wr_data  = wdata;
            tb_op_type  = 1'b1;
            tb_valid    = 1'b0;
            total_ops   = total_ops + 1;

            @(posedge clk);
            while (!cpu_ready) @(posedge clk);

            @(negedge clk);
            cpu_req  = 1'b0;
            tb_valid = 1'b1;
            @(posedge clk);
            tb_valid = 1'b0;
        end
    endtask

    // =========================================================================
    // Urmarire HIT/MISS prin monitorizarea starii FSM
    // =========================================================================
    always @(posedge clk) begin
        if (dut.state == 3'd1 || dut.state == 3'd3) begin // READ_HIT sau WRITE_HIT
            tb_result  <= 1'b1;
            hits       <= hits + 1;
        end else if (dut.state == 3'd2 || dut.state == 3'd4) begin // MISS
            tb_result  <= 1'b0;
            misses     <= misses + 1;
        end
        // Actualizeaza hit_rate la fiecare tranzactie
        if (total_ops > 0)
            tb_hit_rate <= (hits * 100) / total_ops;
    end

    // =========================================================================
    // Helper: check
    // =========================================================================
    task check;
        input        cond;
        input [255:0] msg;
        begin
            if (cond) begin
                $display("  [PASS] %s", msg);
                passes = passes + 1;
            end else begin
                $display("  [FAIL] %s", msg);
                fails  = fails + 1;
            end
        end
    endtask

    // =========================================================================
    // Adrese helpers
    // =========================================================================
    function [31:0] mkaddr;
        input [18:0] tag;
        input [6:0]  idx;
        input [3:0]  wrd;
        begin mkaddr = {tag, idx, wrd, 2'b00}; end
    endfunction

    // =========================================================================
    // Secventa principala de test
    // =========================================================================
    reg [31:0] rd_data;
    reg [31:0] rnd_data [0:7];
    integer i;

    initial begin
        // Seed aleatoriu bazat pe timp de simulare (diferit la fiecare rulare)
        seed = $time ^ 32'hDEAD_CAFE;
        $srandom(seed);

        // Initializare
        rst         = 1'b1;
        cpu_req     = 1'b0;
        cpu_rw      = 1'b0;
        cpu_addr    = 32'b0;
        cpu_wr_data = 32'b0;
        tb_op_type  = 1'b0;
        tb_result   = 1'b0;
        tb_valid    = 1'b0;
        tb_evict    = 1'b0;
        tb_addr     = 32'b0;
        tb_wr_data  = 32'b0;
        tb_rd_data  = 32'b0;
        tb_hit_rate = 7'd0;
        total_ops   = 0;
        hits        = 0;
        misses      = 0;
        evictions   = 0;
        passes      = 0;
        fails       = 0;

        // Genereaza 8 valori aleatorii pentru write tests
        for (i = 0; i < 8; i = i + 1)
            rnd_data[i] = $random;

        repeat(4) @(posedge clk);
        rst = 1'b0;
        repeat(2) @(posedge clk);

        $display("=========================================================");
        $display("  Cache Controller Testbench  |  Seed = %0d", seed);
        $display("  Config: 4-way, 128 sets, 64B/bloc, LRU, Write-back");
        $display("=========================================================");

        // -----------------------------------------------------------------
        // TC1: Read miss rece
        // -----------------------------------------------------------------
        $display("\n[TC1] Read Miss (cache rece)");
        do_read(mkaddr(19'd1, 7'd0, 4'd0), rd_data);
        check(cpu_ready, "TC1: cpu_ready dupa read miss");
        $display("       addr=0x%08h  data=0x%08h", mkaddr(19'd1,7'd0,4'd0), rd_data);

        // -----------------------------------------------------------------
        // TC2: Read hit ? aceeasi adresa
        // -----------------------------------------------------------------
        $display("\n[TC2] Read Hit");
        do_read(mkaddr(19'd1, 7'd0, 4'd0), rd_data);
        check(cpu_ready, "TC2: cpu_ready la read hit");

        // -----------------------------------------------------------------
        // TC3: Write miss cu date aleatorii
        // -----------------------------------------------------------------
        $display("\n[TC3] Write Miss + Write-Allocate  (data=0x%08h)", rnd_data[0]);
        do_write(mkaddr(19'd2, 7'd0, 4'd3), rnd_data[0]);
        check(cpu_ready, "TC3: cpu_ready dupa write-allocate");

        // -----------------------------------------------------------------
        // TC4: Write hit + verificare citire
        // -----------------------------------------------------------------
        $display("\n[TC4] Write Hit  (data=0x%08h)", rnd_data[1]);
        do_write(mkaddr(19'd2, 7'd0, 4'd3), rnd_data[1]);
        check(cpu_ready, "TC4: cpu_ready la write hit");
        do_read(mkaddr(19'd2, 7'd0, 4'd3), rd_data);
        check(rd_data == rnd_data[1], "TC4: citire dupa write hit - data corecta");
        $display("       Asteptat=0x%08h  Citit=0x%08h", rnd_data[1], rd_data);

        // -----------------------------------------------------------------
        // TC5: Acces set diferit cu date aleatorii
        // -----------------------------------------------------------------
        $display("\n[TC5] Read Miss pe alt set");
        do_read(mkaddr(19'd5, 7'd42, 4'd7), rd_data);
        check(cpu_ready, "TC5: cpu_ready pe set diferit");

        // -----------------------------------------------------------------
        // TC6: Umple toate 4 way-uri -> evictie dirty
        // -----------------------------------------------------------------
        $display("\n[TC6] Evictie (victim dirty)");
        // Scrie in set=2, tag=10 -> devine dirty
        do_write(mkaddr(19'd10, 7'd2, 4'd1), rnd_data[2]);
        // Umple celelalte 3 way-uri cu read
        do_read(mkaddr(19'd11, 7'd2, 4'd0), rd_data);
        do_read(mkaddr(19'd12, 7'd2, 4'd0), rd_data);
        do_read(mkaddr(19'd13, 7'd2, 4'd0), rd_data);
        // Re-acceseaza 11,12,13 -> tag=10 devine LRU
        do_read(mkaddr(19'd11, 7'd2, 4'd0), rd_data);
        do_read(mkaddr(19'd12, 7'd2, 4'd0), rd_data);
        do_read(mkaddr(19'd13, 7'd2, 4'd0), rd_data);
        // Acces tag=14 -> evictie tag=10 (dirty, writeback)
        do_read(mkaddr(19'd14, 7'd2, 4'd0), rd_data);
        check(cpu_ready, "TC6: cpu_ready dupa evictie dirty");
        $display("       tag=10 (dirty) evacuat si scris in memorie");

        // -----------------------------------------------------------------
        // TC7: Ordine LRU cu 4 way-uri
        // -----------------------------------------------------------------
        $display("\n[TC7] Verificare ordine LRU");
        do_read(mkaddr(19'd30, 7'd7, 4'd0), rd_data);
        do_read(mkaddr(19'd31, 7'd7, 4'd0), rd_data);
        do_read(mkaddr(19'd32, 7'd7, 4'd0), rd_data);
        do_read(mkaddr(19'd33, 7'd7, 4'd0), rd_data);
        // Re-acceseaza 30,31,32 -> tag=33 devine LRU
        do_read(mkaddr(19'd30, 7'd7, 4'd0), rd_data);
        do_read(mkaddr(19'd31, 7'd7, 4'd0), rd_data);
        do_read(mkaddr(19'd32, 7'd7, 4'd0), rd_data);
        // tag=34 -> tag=33 evacuat (curat, fara writeback)
        do_read(mkaddr(19'd34, 7'd7, 4'd0), rd_data);
        check(cpu_ready, "TC7: LRU corect - tag=33 evacuat");

        // -----------------------------------------------------------------
        // TC8: Burst aleatoriu ? 20 accese pe 6 adrese diferite
        //       Genereaza mix natural de hit-uri si miss-uri
        // -----------------------------------------------------------------
        $display("\n[TC8] Burst aleatoriu (20 accese, 6 adrese)");
        begin : burst_block
            reg [31:0] addrs [0:5];
            integer op, ai;
            addrs[0] = mkaddr(19'd50, 7'd10, 4'd0);
            addrs[1] = mkaddr(19'd51, 7'd10, 4'd2);
            addrs[2] = mkaddr(19'd52, 7'd10, 4'd4);
            addrs[3] = mkaddr(19'd53, 7'd10, 4'd0);
            addrs[4] = mkaddr(19'd54, 7'd10, 4'd1);
            addrs[5] = mkaddr(19'd50, 7'd10, 4'd3); // re-hit pe tag=50

            for (i = 0; i < 20; i = i + 1) begin
                ai = $random % 6;
                op = $random % 2;
                if (op == 0)
                    do_read(addrs[ai], rd_data);
                else
                    do_write(addrs[ai], $random);
            end
        end
        check(1'b1, "TC8: Burst aleatoriu completat");

        // -----------------------------------------------------------------
        // TC9: Re-citire adresa evacuata -> trebuie sa fie miss
        // -----------------------------------------------------------------
        $display("\n[TC9] Re-citire adresa evacuata");
        do_read(mkaddr(19'd33, 7'd7, 4'd0), rd_data);
        check(cpu_ready, "TC9: cpu_ready la re-fetch bloc evacuat");

        // =================================================================
        // Sumar final
        // =================================================================
        $display("\n=========================================================");
        $display("  SUMAR SIMULARE");
        $display("---------------------------------------------------------");
        $display("  Total accese    : %0d", total_ops);
        $display("  Hit-uri         : %0d", hits);
        $display("  Miss-uri        : %0d", misses);
        $display("  Evacuari        : %0d", evictions);
        $display("  Rata de hit     : %0d%%",
                 (total_ops > 0) ? (hits * 100 / total_ops) : 0);
        $display("---------------------------------------------------------");
        $display("  Teste trecute   : %0d", passes);
        $display("  Teste picate    : %0d", fails);
        $display("=========================================================");

        $finish;
    end

    // =========================================================================
    // Watchdog
    // =========================================================================
    initial begin
        #1_000_000;
        $display("[WATCHDOG] Timeout - posibil deadlock!");
        $finish;
    end

    // =========================================================================
    // Dump VCD pentru ModelSim / GTKWave
    // =========================================================================
    initial begin
        $dumpfile("cache_wave.vcd");
        $dumpvars(0, cache_tb);
    end

endmodule
